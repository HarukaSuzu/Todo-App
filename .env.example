# Supabaseの「Project Settings > Data API」でProject URLを、
# 「Project Settings > API Keys」の Publishable and secret API keys タブで
# Publishable key を取得して .env にコピーしてください。
# （旧称は anon キーですが、現在はPublishable keyが推奨されています。
#   どちらも同じ変数名にそのまま値を入れれば動きます）
#
# NEXT_PUBLIC_ を付けているのは、このキーがブラウザ側にも渡ってよい
# （＝Publishable keyはRow Level Securityの制約下でしか使えない、安全な公開鍵だから）ため。
# サーバー専用の強力な鍵（旧service_role / 新Secret key）は、
# 今回のアプリではもう使わないので設定不要です。
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-publishable-key
